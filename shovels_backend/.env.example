# Backend Environment Configuration

# Development Mode
# Set to true to use local login (no Google OAuth required)
LOCAL_MODE=true

# JWT Secret Key (used for token signing)
JWT_SECRET_KEY=local-dev-secret-key-change-in-production

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth Credentials (only needed when LOCAL_MODE=false)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
